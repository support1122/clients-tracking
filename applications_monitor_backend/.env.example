# Database Configuration (REQUIRED)
MONGODB_URI=your_mongodb_connection_string_here

# Server Configuration
PORT=8086
NODE_ENV=development

# JWT Configuration (REQUIRED)
JWT_SECRET=your_super_secret_jwt_key_here

# CORS Configuration (REQUIRED)
CORS_ORIGIN=your_frontend_url_here

# Job card reminder (optional): Discord webhook URL. Cron runs at 8:00 PM IST daily;
# one message per client who has >0 jobs in "saved", now also stating how many job
# cards were ADDED for that client today against their daily target.
# DISCORD_JOBCARD_REMINDER=https://discord.com/api/webhooks/...

# Zero saved / no-adds reminder (optional): Discord webhook URL. Cron runs at 1:30 PM
# IST daily; active + Unpaused only (excludes Paused & New); case-insensitive job
# userID match; includes last job-card adder (addedBy / operator / extension code).
# Fires when the saved column is empty OR when nothing has been added today — it used
# to fire only at exactly zero saved LIFETIME, which one stale card suppressed forever.
# DISCORD_ZERO_SAVED=https://discord.com/api/webhooks/...

# Add shortfall report (optional): Discord webhook URL. Cron runs at 9:30 PM IST daily,
# thirty minutes before the 22:00 IST add window closes, so an operator who is short
# still has time to fix it. Lists every active + unpaused client whose jobs-added-today
# is below their daily target (profile.targetJobCount, else 30 — the same number
# dailyCapGuard enforces as the ceiling), worst shortfall first, naming who added for
# them today. Use a SEPARATE channel from the two reminders above: this is a scoreboard
# a team lead reads top to bottom, not a per-client nag.
# DISCORD_ADD_SHORTFALL=https://discord.com/api/webhooks/...

# Portal URL (optional - for tag notification email links; defaults to CORS_ORIGIN)
# PORTAL_URL=https://portal.flashfirejobs.com

# Gmail OAuth (REQUIRED — replaces SendGrid for OTP/milestone/tag emails)
# 1. Create Google Cloud OAuth client (Web application). Authorized redirect: https://<your-backend>/auth/google/callback
# 2. From the frontend top bar click "Connect Google Account" and sign in with the Gmail to be used as system sender.
# 3. Connecting a new account automatically replaces the previous one (single global sender).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-backend/auth/google/callback

# Internal sync: API key for /api/internal/sync-document-upload (Flashfire calls this when client uploads resume/cover letter)
# Must match CLIENT_TRACKING_INTERNAL_KEY in Flashfire backend
# INTERNAL_SYNC_API_KEY=your-secret-shared-key

# R2 Storage (optional - for onboarding attachments; set USE_R2_FOR_NEW_UPLOADS=true to use R2)
# USE_R2_FOR_NEW_UPLOADS=true
# R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com/test
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=test
# R2_PUBLIC_URL=https://pub-xxx.r2.dev/test
