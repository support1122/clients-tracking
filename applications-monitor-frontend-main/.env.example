# Client Tracking Portal - frontend environment
#
# Copy to .env for local work. In production these are set in the Render /
# Vercel dashboard, NOT in a file.
#
# READ THIS BEFORE ADDING A VARIABLE: Vite inlines every VITE_* value into the
# JavaScript bundle at build time. Anything here is readable by anyone who
# opens the site. Never put an API key, a shared secret or a password in this
# file - if a route needs a secret, the secret belongs on the server and the
# route needs a different way to authorise the browser.


# ── Backends ──────────────────────────────────────────────────────────

# The Client Tracking backend (applications_monitor_backend).
# Local:      http://localhost:5001
# Production: https://applications-monitor-api.flashfirejobs.com
VITE_BASE=http://localhost:5001

# The FlashFire dashboard backend (flashfire-dashboard-backend).
# Used by the AI Summary panel on Client Details, the AI Summaries page, and
# the Auto Extension report.
# Local:      http://localhost:8086
# Production: https://dashboard-api.flashfirejobs.com
VITE_DASHBOARD_BASE=http://localhost:8086

# Microservice used by the onboarding flow.
# Local: http://localhost:5000
VITE_MICROSERVICE_URL=http://localhost:5000

# Internal JR scraper (DASH/scraper). Powers the "Scrape All" batch runner on
# Client Job Analysis. Leave at the dev port unless the scraper is reachable
# off-machine; the page degrades quietly when it is offline.
VITE_SCRAPER_BASE=http://localhost:8092

# The FlashFire client-facing API and portal, used to build outbound links.
# Production: https://dashboard-api.flashfirejobs.com and
#             https://portal.flashfirejobs.com
VITE_FLASHFIRE_API_BASE_URL=
VITE_PORTAL_BASE=


# ── Auto Extension report ─────────────────────────────────────────────
#
# Nothing to add. The report reads VITE_DASHBOARD_BASE above and sends no
# credentials of its own.
#
# The Scrape button posts to /autopilot/queue on the dashboard backend, which
# is deliberately NOT shared-secret gated. Gating it would have meant putting
# OPS_SECRET_KEY in this file, and that same key guards the routes that email
# clients - publishing it in the bundle to protect a scrape button is a bad
# trade. The routes only the autopilot calls (/autopilot/runs,
# /autopilot/queue/claim, .../finish) stay gated, and the autopilot holds the
# key in its own config.json on the server.
